    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "\nitens = _items\nrefinamento = itens[0][\"json\"]\n\npergunta = (refinamento.get(\"pergunta_nova_consulta\") or \"\").strip()\n\nif not pergunta:\n    return [{\n        \"json\": {\n            \"sem_nova_pergunta\": True,\n            \"resposta_escolhida\": refinamento.get(\"resposta_escolhida\", \"\")\n        }\n    }]\n\nreturn [{\n    \"json\": {\n        \"pergunta\": pergunta\n    }\n}]\n"
      },
